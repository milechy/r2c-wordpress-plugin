<?xml version="1.0"?>
<ruleset name="r2c-ai-concierge">
	<description>Coding standards for the R2C AI Concierge WordPress plugin.</description>

	<file>.</file>
	<exclude-pattern>/vendor/*</exclude-pattern>
	<exclude-pattern>/node_modules/*</exclude-pattern>
	<exclude-pattern>/languages/*</exclude-pattern>

	<arg value="sp"/>
	<arg name="basepath" value="."/>
	<arg name="colors"/>
	<arg name="extensions" value="php"/>

	<!-- WordPress.org Detailed Plugin Guidelines #4: code must be human
	     readable. WPCS + PHPCompatibilityWP are the standard tooling to
	     keep this true and to catch calls to functions the declared
	     minimum PHP (7.4, per the plugin header) doesn't have. -->
	<rule ref="PHPCompatibilityWP"/>
	<config name="testVersion" value="7.4-"/>

	<!-- CLAUDE.md (this repo): all option/hook/function/class names carry
	     the r2c_ prefix — same requirement WPCS' prefix sniff checks for. -->
	<rule ref="WordPress.NamingConventions.PrefixAllGlobals">
		<properties>
			<property name="prefixes" type="array">
				<element value="r2c_"/>
				<element value="R2C_"/>
				<element value="R2C_AI_Concierge"/>
			</property>
		</properties>
	</rule>

	<rule ref="WordPress.Files.FileName">
		<properties>
			<property name="is_theme" value="false"/>
		</properties>
	</rule>

	<!-- Docblock-completeness sniffs excluded on purpose, not out of
	     laziness. `WordPress` pulls in Squiz.Commenting's requirement for a
	     full /** */ block (with @param on every argument) on every single
	     method, including one-line private getters like get_api_key().
	     No wordpress.org Detailed Plugin Guideline requires this — #4 asks
	     for human-readable code, not formal doc-block completeness — and
	     this repo's own conventions (see the parent commerce-faq-tasks
	     CLAUDE.md, and this file's own comment style) explicitly avoid
	     comments that only restate what a well-named function already
	     says. Public entry points (wp_ajax_* handlers, REST callbacks,
	     hook registrations) still carry real doc comments in this codebase
	     — that's a deliberate choice, not something enforced mechanically
	     here. Everything else phpcs checks (escaping, nonces, prefixing,
	     SQL, array/whitespace style, inline-comment punctuation) stays on. -->
	<rule ref="WordPress">
		<exclude name="Squiz.Commenting.FunctionComment.Missing"/>
		<exclude name="Squiz.Commenting.FunctionComment.MissingParamTag"/>
		<exclude name="Squiz.Commenting.FunctionComment.MissingParamComment"/>
		<exclude name="Squiz.Commenting.ClassComment.Missing"/>
		<!-- WrongStyle fires whenever a `//` comment sits near a function
		     with no docblock, assuming it's a mis-styled attempt at
		     documenting that function. False positive for this codebase's
		     `// ---- 見出し ----` section dividers, which group related
		     methods rather than document one. -->
		<exclude name="Squiz.Commenting.FunctionComment.WrongStyle"/>
	</rule>
</ruleset>
