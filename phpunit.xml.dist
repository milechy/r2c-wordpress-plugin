<?xml version="1.0" encoding="UTF-8"?>
<phpunit
	bootstrap="tests/bootstrap.php"
	colors="true"
	beStrictAboutTestsThatDoNotTestAnything="true"
>
	<testsuites>
		<testsuite name="unit">
			<directory suffix=".php">tests</directory>
			<exclude>tests/bootstrap.php</exclude>
		</testsuite>
	</testsuites>
</phpunit>
